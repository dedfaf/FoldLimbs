    <jobString>Installing bionic leg.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BionicLeg</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BionicLeg</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Leg</li>
    </appliedOnFixedBodyParts>
    <addsHediff>BionicLeg</addsHediff>
    <limbKind>Leg</limbKind>
    <side>Right</side>
  </RecipeDef>

</Defs>