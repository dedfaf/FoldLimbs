<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>

    <!-- Modify RootNamespace, AssemblyName, OutputPath, VersionPrefix -->
    <RootNamespace>FoldLimbs</RootNamespace>
    <AssemblyName>FoldLimbs</AssemblyName>
    <OutputPath>../1.6/Assemblies</OutputPath>
    <VersionPrefix>0.1.0.0</VersionPrefix>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>

    <!-- Def subclass fields are filled from XML, not from code -->
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Source/*" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="*" />
    <!-- Compile-time only reference; the Harmony DLL itself is provided by the Harmony framework mod (brrainz.harmony). -->
    <PackageReference Include="Lib.Harmony.Thin" Version="2.3.6" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
